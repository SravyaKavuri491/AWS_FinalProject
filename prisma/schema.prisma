generator client {
  provider = "prisma-client-js"
  //output   = "./node_modules/.prisma/client"  // Add this line
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int                @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String             @unique
  password      String
  phoneNumber   String?
  address       String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  registrations EventRegistration[] @relation("UserRegistrations")
  giftRegistrations GiftRegistration[] @relation("UserGiftRegistrations")
}


model Feedback {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  issue     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model EventRegistration {
  id          Int       @id @default(autoincrement())
  name        String
  email       String
  eventName   String
  cost        Float
  userId      Int
  user        User      @relation("UserRegistrations", fields: [userId], references: [id])
  eventId     Int
  event       Event     @relation(fields: [eventId], references: [id])
  paymentDetails PaymentDetails?
  createdAt   DateTime  @default(now())
}

model PaymentDetails {
  id              Int       @id @default(autoincrement())
  cardNumberHash  String
  cardExpiryHash  String
  cardCvcHash     String
  amount          Float
  paymentStatus   String
  registrationId  Int       @unique
  registration    EventRegistration @relation(fields: [registrationId], references: [id])
  createdAt       DateTime  @default(now())
}

model GiftRegistration {
  id          Int       @id @default(autoincrement())
  name        String
  email       String
  userId      Int?
  user        User?     @relation("UserGiftRegistrations", fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Event {
  id              Int                @id @default(autoincrement())
  name            String
  description     String?
  date            DateTime
  location        String
  price           Float
  registrations   EventRegistration[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}